# Redis Eats RAG Workshop — Environment Variables Example
# Copy this file to .env and fill in your values.
# NOTE: The notebook prompts for credentials interactively.
#       This file is provided for local development convenience only.

# Redis Cloud connection
REDIS_HOST=your-redis-cloud-host.redis.io
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# OpenAI
OPENAI_API_KEY=sk-...

# LangCache (Redis Cloud — preview)
LANGCACHE_URL=https://your-langcache-host
LANGCACHE_CACHE_ID=your-cache-id
LANGCACHE_API_KEY=your-langcache-api-key
